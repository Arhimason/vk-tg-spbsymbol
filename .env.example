# Токен пользователя VK с доступом к messages.
# Сессия VK Messenger продлевается сама из data/vk-session.json, клиент 51453752.
# VK_REFRESH_TOKEN нужен только для отдельного входа VK ID, не для мессенджера.
VK_ACCESS_TOKEN=
VK_REFRESH_TOKEN=
VK_DEVICE_ID=
VK_CLIENT_ID=

# Личная сессия Telegram. api_id и api_hash — с https://my.telegram.org
# Прокси нет: Telethon ходит напрямую.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/telegram.session

# Бот публикует входящие из VK. В исходящих ответах его не видно: их читает личная сессия.
TELEGRAM_BOT_TOKEN=

DATABASE_PATH=data/bridge.db
